# Research receipts hash exact bytes. Keep source, configuration and public
# artifacts identical across operating systems, including Windows checkouts.
* text=auto eol=lf

*.py text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary

# Frozen receipts bind exact bytes, including existing line endings. Disable
# conversion for every path so a Windows commit and a Linux checkout retain
# the same scientific inputs, code and presentation evidence hashes.
* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib SVG path records contain generated separator spaces.
site/assets/validation-*.svg -whitespace
