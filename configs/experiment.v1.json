{
  "schema_version": 1,
  "protocol_version": "0.1.0",
  "status": "proposed_design_not_backtest",
  "timezone": "America/New_York",
  "currency": "USD",
  "period": {
    "anchor_close": "2025-12-31",
    "end_close": "2026-10-02",
    "warmup_request_start": "2024-12-01",
    "warmup_min_price_points": 253,
    "classification": "retrospective_exploratory",
    "initial_state": "cash",
    "initial_execution": "first_exchange_session_open_after_anchor",
    "terminal_liquidation": false
  },
  "universe": {
    "name": "point_in_time_sp500_securities",
    "requires_effective_at": true,
    "requires_known_at": true,
    "current_constituents_backfill_allowed": false,
    "rank_tiebreaker": "security_id_ascending"
  },
  "signal_definition": {
    "price": "split_adjusted_excluding_cash_dividends",
    "skip_sessions": 21,
    "lookback_sessions": [252, 126, 63],
    "formula": "P[t-21] / P[t-L] - 1",
    "volatility_window": "daily_simple_returns_t-L+1_through_t-21_inclusive",
    "volatility_ddof": 1,
    "validate_windows": "positive_weight_windows_only",
    "annualization_sessions": 252,
    "zero_or_missing_volatility": "ineligible",
    "nonpositive_combined_score": "ineligible",
    "cross_sectional_zscore": false
  },
  "common": {
    "signal_time": "scheduled_session_close",
    "execution_time": "next_exchange_session_open",
    "semiannual_signal_months": [3, 9],
    "semiannual_signal_day": "last_exchange_session_of_month",
    "monthly_signal_day": "last_exchange_session_of_month",
    "security_weight_cap": 0.08,
    "cap_applied": "target_weights_at_scheduled_rebalance_only",
    "market_cap": "point_in_time_security_class_total_market_cap_usd",
    "market_cap_missing_nonpositive_nonfinite": "ineligible_and_logged_data_gaps_block_formal_results",
    "negative_cash_allowed": false,
    "cash_annual_yield": 0.0,
    "taxes_modeled": false,
    "fractional_shares": true,
    "shorting_allowed": false,
    "initial_purchase_cost_included": true,
    "forced_membership_exit": "next_tradable_open_after_effective_and_known",
    "forced_exit_proceeds": "cash_until_scheduled_rebalance",
    "dividend_accounting": "receivable_on_ex_date_cash_on_pay_date",
    "dividend_reinvestment": "new_dividend_cash_only_next_open_proportional_to_prior_close_eligible_existing_holdings_else_cash",
    "same_open_event_priority": ["corporate_actions", "forced_membership_exits", "scheduled_rebalance_else_dividend_reinvestment"],
    "same_security_orders": "net_before_execution_and_cost",
    "unfilled_regular_orders": "cancel_same_day_no_automatic_retry",
    "unfilled_forced_exit": "retry_next_tradable_open",
    "insufficient_cash": "scale_executable_buys_proportionally_including_cost_never_advance_unfilled_sales",
    "opening_fill_model": "idealized_full_fill_at_raw_open_fractional_shares_after_cost_no_capacity_claim",
    "missing_execution_price": "no_fill_record_exception_no_trade_forward_fill",
    "cost_bps_per_side_base": 5,
    "cost_bps_per_side_scenarios": [0, 5, 10, 25],
    "cost_denominator": "absolute_executed_notional",
    "insufficient_candidates_equity_budget": "min(1, eligible_selected_count / target_count)",
    "cap_residual": "iterative_proportional_redistribution_else_cash",
    "selection_buffer": "top60_first_then_existing_rank_at_most100_then_best_remaining_to_target",
    "trend_filter": "new_entries_only_split_adjusted_close_above_sma200",
    "weekly_risk_overlay": false
  },
  "arms": {
    "B0": {"rebalance": "semiannual", "signal_weights": [1.0, 0.0, 0.0], "target_count": 100, "buffer": false, "cap_exponent": 1.0, "entry_trend_filter": false},
    "B1": {"rebalance": "monthly", "signal_weights": [1.0, 0.0, 0.0], "target_count": 100, "buffer": false, "cap_exponent": 1.0, "entry_trend_filter": false},
    "B2": {"rebalance": "monthly", "signal_weights": [0.5, 0.3, 0.2], "target_count": 100, "buffer": false, "cap_exponent": 1.0, "entry_trend_filter": false},
    "B3": {"rebalance": "monthly", "signal_weights": [0.5, 0.3, 0.2], "target_count": 75, "buffer": true, "cap_exponent": 1.0, "entry_trend_filter": false},
    "B4": {"rebalance": "monthly", "signal_weights": [0.5, 0.3, 0.2], "target_count": 75, "buffer": true, "cap_exponent": 0.5, "entry_trend_filter": false},
    "F_FAST": {"rebalance": "monthly", "signal_weights": [0.5, 0.3, 0.2], "target_count": 75, "buffer": true, "cap_exponent": 0.5, "entry_trend_filter": true},
    "F_SLOW": {"rebalance": "semiannual", "signal_weights": [0.5, 0.3, 0.2], "target_count": 75, "buffer": true, "cap_exponent": 0.5, "entry_trend_filter": true}
  },
  "aliases": {"B5": "F_FAST"},
  "benchmarks": {
    "tradeable": ["SPMO", "SPY"],
    "same_initial_execution_and_external_trade_cost": true,
    "embedded_fund_expenses_subtracted_again": false,
    "standard_close_to_close_ytd": "reference_only_separate_table"
  },
  "comparisons": {
    "primary_frequency": ["F_FAST", "F_SLOW"],
    "primary_real_world": ["F_FAST", "SPMO"],
    "secondary_market": ["F_FAST", "SPY"],
    "ablation_chain": [["B1", "B0"], ["B2", "B1"], ["B3", "B2"], ["B4", "B3"], ["F_FAST", "B4"]]
  },
  "metrics": {
    "primary": "net_total_return_difference_percentage_points",
    "risk_guardrail": "maximum_drawdown",
    "execution_guardrail": "two_sided_traded_notional_over_pretrade_nav",
    "diagnostics": ["gross_total_return", "monthly_returns", "cost_drag", "cash_weight", "holdings_count", "largest_security_weight"],
    "sharpe": "secondary_only_requires_explicit_risk_free_series",
    "performance_target": null,
    "significance_claim_from_ytd_alone": false
  },
  "deferred": ["weekly_risk_overlay", "turbo", "parameter_search", "live_trading"],
  "results": {"executed": false, "market_returns": null}
}
